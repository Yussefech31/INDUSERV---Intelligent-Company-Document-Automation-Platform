# Environment configuration for INDUSERV

# Environment
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1
SECRET_KEY=induserv_super_secret_local_key_change_in_production_2026

# Database (SQLite by default, easily swapped for PostgreSQL)
DATABASE_URL=sqlite:///./induserv.db

# Storage Directories (relative to project root or absolute)
STORAGE_BASE_DIR=../storage
UPLOAD_DIR=../storage/uploads
GENERATED_DIR=../storage/generated
TEMPLATES_DIR=../storage/templates

# AI Provider Settings
# Options: "free_api", "ollama", "openai_compatible"
DEFAULT_AI_PROVIDER=free_api

# Free API Provider Options (OpenRouter, Groq, etc.)
# Groq or OpenRouter provide free tiers with high quality models.
FREE_API_BASE_URL=https://openrouter.ai/api/v1
FREE_API_KEY=
FREE_API_DEFAULT_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Ollama Local Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2:latest

# CORS Settings
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

